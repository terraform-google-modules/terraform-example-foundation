module "routers" {
  source = "../routers"

  project_id = local.shared_vpc_project_id
  vpc_name   = "${var.environment_code}-svpc"

  router_config = {
    bgp_asn           = local.bgp_asn_number
    advertised_groups = ["ALL_SUBNETS"]
    advertised_ip_ranges = [
      { range = local.dns_forward_source_range },
      { range = "${var.private_service_connect_ip}/32" }
    ]

    routers = { // comment entries related to region 2 if you are in a single region environment
      "region1_router1" = {
        region    = var.default_region1
        cr_suffix = "cr1"
      }
      "region1_router2" = {
        region    = var.default_region1
        cr_suffix = "cr2"
      }
      "region2_router1" = {
        region    = var.default_region2
        cr_suffix = "cr3"
      }
      "region2_router2" = {
        region    = var.default_region2
        cr_suffix = "cr4"
      }
    }
  }

  depends_on = [
    module.shared_vpc
  ]
}
