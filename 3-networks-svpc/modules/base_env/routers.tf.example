module "routers" {
  source = "../routers"

  project_id     = local.shared_vpc_project_id
  region1        = var.default_region1
  region2        = var.default_region2
  vpc_name       = "${var.environment_code}-svpc"
  bgp_asn_subnet = local.bgp_asn_number

  advertised_ip_ranges = [
    { range = local.dns_forward_source_range },
    { range = "${var.private_service_connect_ip}/32" }
  ]

  depends_on = [
    module.shared_vpc
  ]
}
